# Copy to .env for local development (never commit real secrets).

# SQLite — relative ok when cwd is the app dir; in Docker/HF use absolute sqlx URL:
#   sqlite:///home/user/app/auth.db
# (three slashes after sqlite: for an absolute path.)
DATABASE_URL=sqlite:auth.db

# Redis — managed URLs often use TLS: rediss://user:pass@host:6379
REDIS_URL=redis://127.0.0.1:6379
# Last resort if TLS verification fails (e.g. some cloud Redis endpoints):
# REDIS_TLS_INSECURE=1

# JWT signing secret — at least 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-minimum-length

JWT_EXPIRY_SECS=300
OPAQUE_TOKEN_TTL_SECS=3600

# Internal bind for auth only (not the Space public port).
AUTH_LISTEN_ADDR=0.0.0.0:3001

# Optional: when set, POST /internal/token/exchange requires header x-internal-secret.
# The api-gateway must use the same value.
# INTERNAL_EXCHANGE_SECRET=replace-with-long-random-string
