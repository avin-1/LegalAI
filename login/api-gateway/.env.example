# Copy to .env for local development (never commit real secrets).

LISTEN_ADDR=0.0.0.0:7860
AUTH_SERVICE_URL=http://127.0.0.1:3001

# Optional: forward /embed/* to your embedding service.
# EMBEDDING_API_URL=http://localhost:8000

# Optional: forward /graph/* to your graph service.
# GRAPH_API_URL=http://localhost:8001

# Optional: must match auth-service INTERNAL_EXCHANGE_SECRET when that is set.
# INTERNAL_EXCHANGE_SECRET=replace-with-long-random-string

# Optional: comma-separated exact origins. If unset, all origins are allowed.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example,https://your-space.hf.space
